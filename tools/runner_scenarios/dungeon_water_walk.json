{
  "name": "dungeon_water_walk",
  "description": "(visual) copia di dungeon_direct: dopo il load cammina avanti con W a scatti da 3 s con screenshot, per inquadrare l'acqua subito dopo l'ingresso del dungeon.",
  "baseline": "B0_raw",
  "params": {
    "unit": "dlc_dungeon",
    "alive_seconds": 8,
    "load_timeout_s": 150
  },
  "timeouts": {
    "total_s": 600
  },
  "critical": [
    "dlc_dungeon*.drm",
    "dlc_water_wheel*.drm",
    "dlc_watertunnel*.drm",
    "dlc_pillory*.drm",
    "dlc1_uo_dungeon_final_gate.drm",
    "dlc1_uo_raft_bridge.drm",
    "streamgroups\\*dungeon*"
  ],
  "saves": {
    "_note": "set = work/baseline/saves/dungeon_direct/ (da creare; se manca si usa baseline/<B>/saves come fallback). Serve un save qualunque da cui Resume entri in un livello DLC: l'unita' si carica solo da dentro un livello (il Load unit dal menu principale non e' mai stato provato).",
    "set": "dungeon_direct",
    "fallback_baseline": true,
    "touch": [
      "Autosave.TRUSave"
    ]
  },
  "markers": [
    {
      "name": "dungeon_unit",
      "regex": "\\*\\*\\* CURRENT LEVEL = dlc_dungeon(?![A-Za-z0-9_])"
    },
    {
      "name": "dungeon_main_sg",
      "regex": "Loading PC-W\\\\StreamGroups\\\\dlc_dungeon_dungeon_main\\.drm"
    }
  ],
  "steps": [
    {
      "id": "boot",
      "action": "boot_resume",
      "enter_first_s": 20,
      "enter_every_s": 8,
      "max_enters": 6,
      "timeout_s": 180,
      "settle_s": 8
    },
    {
      "id": "shot_boot",
      "action": "shot",
      "name": "after_resume"
    },
    {
      "id": "menu_open",
      "action": "f8",
      "state": "open"
    },
    {
      "id": "load",
      "action": "load_unit",
      "unit": "${unit}",
      "timeout_s": "${load_timeout_s}",
      "expect_regex": "(?m)(\\*\\*\\* CURRENT LEVEL = dlc_dungeon(?![A-Za-z0-9_])|Loading PC-W\\\\StreamGroups\\\\dlc_dungeon_dungeon_main\\.drm)"
    },
    {
      "id": "menu_close",
      "action": "f8",
      "state": "close"
    },
    {
      "id": "alive",
      "action": "soak",
      "seconds": "${alive_seconds}",
      "from": "last_match",
      "shots_at": [
        5
      ]
    },
    {
      "id": "walk1",
      "action": "hold_key",
      "key": "w",
      "seconds": 3
    },
    {
      "id": "settle1",
      "action": "wait",
      "seconds": 2
    },
    {
      "id": "shot_w1",
      "action": "shot",
      "name": "walk1"
    },
    {
      "id": "walk2",
      "action": "hold_key",
      "key": "w",
      "seconds": 3
    },
    {
      "id": "settle2",
      "action": "wait",
      "seconds": 2
    },
    {
      "id": "shot_w2",
      "action": "shot",
      "name": "walk2"
    },
    {
      "id": "walk3",
      "action": "hold_key",
      "key": "w",
      "seconds": 3
    },
    {
      "id": "settle3",
      "action": "wait",
      "seconds": 2
    },
    {
      "id": "shot_w3",
      "action": "shot",
      "name": "walk3"
    },
    {
      "id": "walk4",
      "action": "hold_key",
      "key": "w",
      "seconds": 3
    },
    {
      "id": "settle4",
      "action": "wait",
      "seconds": 2
    },
    {
      "id": "shot_w4",
      "action": "shot",
      "name": "walk4"
    },
    {
      "id": "final",
      "action": "soak",
      "seconds": 4,
      "from": "now",
      "shots_at": [
        2
      ]
    }
  ],
  "require_markers": [],
  "pass_text": "tru vivo alive_seconds dopo il caricamento di dlc_dungeon, nessun crash"
}