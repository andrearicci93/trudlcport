{
  "name": "raft_auto",
  "description": "TEST AUTOMATICO anello zattera (nessun utente): Resume chain_water, sonda lists 420 s; in parallelo tools/auto_ring_test.ps1 legge i record 0x404 e muove Lara a distanze note dall'anello.",
  "baseline": "B0_raw",
  "params": { "probe_seconds": 20, "water_timeout_s": 150, "probe_interval_ms": 100 },
  "timeouts": { "total_s": 900 },
  "critical": [ "dlc1_uo_raft_bridge.drm", "dlc_water_wheel*.drm", "dlc1_uo_water_wheel.drm" ],
  "saves": {
    "set": "chain_water", "fallback_baseline": true,
    "touch": [ "Savegame 1.TRUSave", "Autosave.TRUSave" ],
    "also_as": { "Savegame 1.TRUSave": "Autosave.TRUSave" }
  },
  "markers": [
    { "name": "raft_sg", "regex": "Loading PC-W\\\\StreamGroups\\\\dlc_water_wheel" },
    { "name": "water_wheel_unit", "regex": "\\*\\*\\* CURRENT LEVEL = dlc_water_wheel" }
  ],
  "steps": [
    { "id": "boot", "action": "boot_resume", "enter_first_s": 20, "enter_every_s": 8, "max_enters": 6, "timeout_s": 180, "settle_s": 5 },
    { "id": "water", "action": "expect", "regex": "CURRENT LEVEL = dlc_water_wheel", "timeout_s": "${water_timeout_s}", "new_only": false },
    { "id": "ext_lists", "action": "ext_probe", "mode": "lists", "seconds": 420, "interval_ms": 100 }
  ],
  "require_markers": [ "water_wheel_unit" ],
  "pass_text": "livello caricato, sonda lists eseguita; il test di distanza e' in ringtest.log"
}
